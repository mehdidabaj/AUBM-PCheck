HOST=0.0.0.0
PORT=8091
NODE_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aubm
MYSQL_PASSWORD=change_me_db_secret
MYSQL_DATABASE=aubm_pcheck

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=aubm_session
# true uniquement derrière HTTPS (nginx TLS)
COOKIE_SECURE=false

# Optionnel : secret one-shot pour POST /api/auth/setup (généré par reset-auth.sh)
# SETUP_SECRET=

# Pas de ADMIN_PASSWORD : le premier admin se crée via l’interface web.
