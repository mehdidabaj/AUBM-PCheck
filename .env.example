HOST=0.0.0.0
PORT=8091
NODE_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aubm
MYSQL_PASSWORD=change_me_db_secret
MYSQL_DATABASE=aubm_pcheck

# Bootstrap UNIQUEMENT si la table users est vide.
# Le mot de passe applicatif est stocké hashé (bcrypt) en MySQL.
# Ne laissez PAS ADMIN_PASSWORD dans .env en production après le 1er démarrage.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=  # à fournir une seule fois, puis supprimer
ADMIN_DISPLAY_NAME=Administrateur

SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=aubm_session
COOKIE_SECURE=false
