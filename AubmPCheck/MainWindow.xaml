<Window x:Class="AubmPCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AubmPCheck.Converters"
        xmlns:vm="clr-namespace:AubmPCheck.ViewModels"
        Title="AUBM PCheck — Fiches Todo PC"
        Height="900" Width="1320"
        MinHeight="720" MinWidth="1024"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
    <conv:InvertBoolConverter x:Key="InvertBool" />

    <Style x:Key="DoneTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough" />
          <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="22,30">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,36">
          <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="12" Margin="0,0,12,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF14B8A6" Offset="0" />
                  <GradientStop Color="#FF0F766E" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="PC" FontWeight="Bold" FontSize="15"
                         Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="AUBM PCheck" FontSize="18" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="Préparation PC" Foreground="{StaticResource SidebarMutedBrush}" FontSize="12.5" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom"
                Background="#14FFFFFF"
                CornerRadius="12"
                Padding="14"
                Margin="0,24,0,0">
          <TextBlock Text="Préparez · cochez · finalisez&#x0a;Puis exportez en PDF ou imprimez."
                     Foreground="{StaticResource SidebarMutedBrush}"
                     FontSize="12"
                     LineHeight="18"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel>
          <Button Command="{Binding ShowEditorCommand}" Margin="0,0,0,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="Editor">
                    <Setter Property="Background" Value="#2A14B8A6" />
                    <Setter Property="BorderBrush" Value="#6614B8A6" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="Nouvelle fiche" />
          </Button>

          <Button Command="{Binding ShowDraftsCommand}" Margin="0,0,0,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="Drafts">
                    <Setter Property="Background" Value="#2A14B8A6" />
                    <Setter Property="BorderBrush" Value="#6614B8A6" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Brouillons" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="9" Padding="8,2" MinWidth="26">
                <TextBlock Text="{Binding DraftsCount}" FontSize="11" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
              </Border>
            </Grid>
          </Button>

          <Button Command="{Binding ShowHistoryCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="History">
                    <Setter Property="Background" Value="#2A14B8A6" />
                    <Setter Property="BorderBrush" Value="#6614B8A6" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Historique" VerticalAlignment="Center" />
              <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="9" Padding="8,2" MinWidth="26">
                <TextBlock Text="{Binding HistoryCount}" FontSize="11" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main workspace -->
    <Grid Grid.Column="1">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFEEF2F7" Offset="0" />
          <GradientStop Color="#FFE4EDF4" Offset="0.55" />
          <GradientStop Color="#FFDCE8EF" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>

      <Grid Margin="36,30,36,28">
        <!-- Editor -->
        <DockPanel>
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentView}" Value="Editor">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>

          <Border DockPanel.Dock="Top" Margin="0,0,0,20" Padding="0,0,0,18"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Renseignez le PC, ajoutez les tâches, puis cochez-les au fur et à mesure."
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                           FontSize="14" TextWrapping="Wrap" />
              </StackPanel>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Nouvelle" Command="{Binding NewFicheCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
                <Button Content="Enregistrer brouillon" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisInvert}}" />
                <Button Content="Imprimer" Command="{Binding PrintFicheCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Exporter PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                <Button Content="Finaliser" Command="{Binding OpenFinalizeDialogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisInvert}}" />
              </WrapPanel>
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                <StackPanel>
                  <DockPanel Margin="0,0,0,18">
                    <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}"
                            DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Informations du PC" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                  </DockPanel>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="18" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Text="Version du Todo PC" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource DarkTextBox}"
                               IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Text="Propriétaire du PC" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource DarkTextBox}"
                               IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Text="Nom complet du PC" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource DarkTextBox}"
                               IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Text="Date de début de préparation" Style="{StaticResource FieldLabel}" />
                      <DatePicker SelectedDate="{Binding StartDate}"
                                  Style="{StaticResource DarkDatePicker}"
                                  IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,16" LastChildFill="True">
                    <Border Style="{StaticResource ProgressPill}" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TasksProgress, StringFormat={}{0} cochées}"
                                 Foreground="{StaticResource AccentStrongBrush}"
                                 FontSize="12.5" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}"
                              Margin="0,0,10,0" VerticalAlignment="Center" />
                      <TextBlock Text="Tâches à faire" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DockPanel>

                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"
                             Margin="0,0,10,0"
                             IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}"
                             KeyDown="NewTaskBox_KeyDown" />
                    <Button Grid.Column="1"
                            Content="Ajouter"
                            MinWidth="110"
                            Command="{Binding AddTaskCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource TaskRowBorder}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Done}"
                                      Style="{StaticResource TaskCheckBox}"
                                      IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource DoneTextStyle}"
                                       VerticalAlignment="Center" Margin="4,0,12,0" />
                            <Button Grid.Column="2"
                                    Content="Supprimer"
                                    Style="{StaticResource DangerButton}"
                                    Padding="12,7"
                                    Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Background="{StaticResource SoftBrush}"
                          BorderBrush="{StaticResource LineBrush}"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="22"
                          Margin="0,4,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="Aucune tâche pour l’instant"
                                 FontWeight="SemiBold"
                                 FontSize="14"
                                 Foreground="{StaticResource TextBrush}"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="Saisissez une tâche ci-dessus puis cliquez sur Ajouter."
                                 Foreground="{StaticResource MutedBrush}"
                                 Margin="0,6,0,0"
                                 HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding StatusMessage}"
                         Foreground="{StaticResource AccentStrongBrush}"
                         Margin="4,18,0,8"
                         FontSize="13.5"
                         FontWeight="SemiBold" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- Drafts -->
        <DockPanel>
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentView}" Value="Drafts">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
            <TextBlock Text="Brouillons" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Fiches en cours de préparation, non encore finalisées."
                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="14" />
          </StackPanel>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Drafts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding PcName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="13.5">
                          <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                          <Run Text="  ·  " /><Run Text="{Binding Owner, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13.5" Margin="0,4,0,0">
                          <Run Text="Début : " />
                          <Run Text="{Binding StartDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                        </TextBlock>
                        <Border Style="{StaticResource ProgressPill}" Margin="0,12,0,0">
                          <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ouvrir" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="PDF" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Supprimer" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.DeleteDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- History -->
        <DockPanel>
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentView}" Value="History">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>

          <Grid DockPanel.Dock="Top" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Historique des Todo PC" Style="{StaticResource PageTitle}" />
              <TextBlock Text="Fiches finalisées avec date de fin de préparation."
                         Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="14" />
            </StackPanel>
            <TextBox Grid.Column="1" Width="300" VerticalAlignment="Center"
                     Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource DarkTextBox}"
                     ToolTip="Rechercher (PC, propriétaire, version)…" />
          </Grid>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding PcName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" FontSize="13.5">
                          <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                          <Run Text="  ·  " /><Run Text="{Binding Owner, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="13.5" Margin="0,4,0,0">
                          <Run Text="Début : " />
                          <Run Text="{Binding StartDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                          <Run Text="  ·  Fin : " />
                          <Run Text="{Binding EndDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                        </TextBlock>
                        <Border Style="{StaticResource ProgressPill}" Margin="0,12,0,0">
                          <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Voir" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="PDF" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Imprimer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Command="{Binding DataContext.PrintFicheCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="Supprimer" Style="{StaticResource DangerButton}"
                                Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>

    <!-- Finalize modal -->
    <Grid Grid.ColumnSpan="2" Panel.ZIndex="20"
          Visibility="{Binding IsFinalizeDialogOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#990B1524" MouseLeftButtonDown="ModalBackdrop_MouseLeftButtonDown" />
      <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="White"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="28">
        <StackPanel>
          <TextBlock Text="Finaliser la fiche" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Indiquez la date de fin de préparation. La fiche passera dans l’historique."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,20" FontSize="14" />
          <TextBlock Text="Date de fin de préparation" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource DarkDatePicker}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Annuler" Command="{Binding CancelFinalizeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
            <Button Content="Confirmer la finalisation" Command="{Binding ConfirmFinalizeCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
