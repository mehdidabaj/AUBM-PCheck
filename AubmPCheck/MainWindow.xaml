<Window x:Class="AubmPCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AubmPCheck.Converters"
        xmlns:vm="clr-namespace:AubmPCheck.ViewModels"
        Title="AUBM PCheck — Fiches Todo PC"
        Height="860" Width="1280"
        MinHeight="680" MinWidth="960"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
    <conv:InvertBoolConverter x:Key="InvertBool" />

    <Style x:Key="DoneTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Done}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough" />
          <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0"
            Background="#F2171E28"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,1,0"
            Padding="20,28">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,28">
          <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
            <TextBlock Text="PC" FontWeight="Bold" FontSize="14"
                       Foreground="#FF06241F"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="AUBM PCheck" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Fiches Todo PC" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="Préparez, cochez, finalisez.&#x0a;Exportez en PDF ou imprimez."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,24,0,0" />

        <StackPanel>
          <Button Content="Nouvelle fiche"
                  Command="{Binding ShowEditorCommand}"
                  Margin="0,0,0,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="Editor">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#592BB8A0" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>

          <Button Command="{Binding ShowDraftsCommand}" Margin="0,0,0,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="Drafts">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#592BB8A0" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Brouillons" />
              <Border Grid.Column="1" Background="{StaticResource BgBrush}" CornerRadius="10" Padding="6,2" MinWidth="22">
                <TextBlock Text="{Binding DraftsCount}" FontSize="11" HorizontalAlignment="Center" />
              </Border>
            </Grid>
          </Button>

          <Button Command="{Binding ShowHistoryCommand}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentView}" Value="History">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#592BB8A0" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Historique" />
              <Border Grid.Column="1" Background="{StaticResource BgBrush}" CornerRadius="10" Padding="6,2" MinWidth="22">
                <TextBlock Text="{Binding HistoryCount}" FontSize="11" HorizontalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Margin="28,24,28,28">
      <!-- Editor -->
      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="Editor">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Text="{Binding EditorTitle}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Renseignez le PC, ajoutez les tâches, puis cochez-les au fur et à mesure."
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top" ItemHeight="36">
            <Button Content="Nouvelle" Command="{Binding NewFicheCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8" />
            <Button Content="Enregistrer brouillon" Command="{Binding SaveDraftCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisInvert}}" />
            <Button Content="Imprimer" Command="{Binding PrintFicheCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
            <Button Content="Exporter PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
            <Button Content="Finaliser" Command="{Binding OpenFinalizeDialogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisInvert}}" />
          </WrapPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="16" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                  <TextBlock Text="Version du Todo PC" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource DarkTextBox}"
                           IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                  <TextBlock Text="Propriétaire du PC" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource DarkTextBox}"
                           IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                  <TextBlock Text="Nom complet du PC" Style="{StaticResource FieldLabel}" />
                  <TextBox Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource DarkTextBox}"
                           IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                  <TextBlock Text="Date de début de préparation" Style="{StaticResource FieldLabel}" />
                  <DatePicker SelectedDate="{Binding StartDate}"
                              Style="{StaticResource DarkDatePicker}"
                              IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <DockPanel Margin="0,0,0,14">
                  <TextBlock Text="Tâches à faire" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                  <TextBlock DockPanel.Dock="Right"
                             Text="{Binding TasksProgress, StringFormat={}{0} cochées}"
                             Foreground="{StaticResource MutedBrush}"
                             VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource DarkTextBox}"
                           Margin="0,0,10,0"
                           IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}"
                           KeyDown="NewTaskBox_KeyDown" />
                  <Button Grid.Column="1"
                          Content="Ajouter"
                          Command="{Binding AddTaskCommand}"
                          Style="{StaticResource PrimaryButton}"
                          IsEnabled="{Binding IsReadOnly, Converter={StaticResource InvertBool}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Tasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource BgBrush}"
                              BorderBrush="{StaticResource LineBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="12"
                              Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding Done}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource DoneTextStyle}" VerticalAlignment="Center" />
                          <Button Grid.Column="2"
                                  Content="Supprimer"
                                  Style="{StaticResource GhostButton}"
                                  Padding="10,6"
                                  Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBool}}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Aucune tâche pour l’instant. Ajoutez la première ci-dessus."
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,16,0,0"
                       FontWeight="SemiBold" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Drafts -->
      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="Drafts">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
          <TextBlock Text="Brouillons" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Fiches en cours de préparation, non encore finalisées."
                     Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Drafts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding PcName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0">
                        <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding Owner, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Foreground="{StaticResource MutedBrush}">
                        <Run Text="Début : " />
                        <Run Text="{Binding StartDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                      </TextBlock>
                      <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Ouvrir" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.OpenDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                      <Button Content="PDF" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Supprimer" Style="{StaticResource DangerButton}"
                              Command="{Binding DataContext.DeleteDraftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <!-- History -->
      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentView}" Value="History">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Text="Historique des Todo PC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="Fiches finalisées avec date de fin de préparation."
                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
          </StackPanel>
          <TextBox Width="320" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource DarkTextBox}"
                   ToolTip="Rechercher (PC, propriétaire, version)…" />
        </DockPanel>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding FilteredHistory}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding PcName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0">
                        <Run Text="Version " /><Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text=" · " /><Run Text="{Binding Owner, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Foreground="{StaticResource MutedBrush}">
                        <Run Text="Début : " />
                        <Run Text="{Binding StartDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                        <Run Text=" · Fin : " />
                        <Run Text="{Binding EndDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                      </TextBlock>
                      <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ProgressLabel}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Voir" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                      <Button Content="PDF" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Imprimer" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                              Command="{Binding DataContext.PrintFicheCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                      <Button Content="Supprimer" Style="{StaticResource DangerButton}"
                              Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <!-- Finalize modal -->
    <Grid Grid.ColumnSpan="2" Panel.ZIndex="20"
          Visibility="{Binding IsFinalizeDialogOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#B8060A0E" MouseLeftButtonDown="ModalBackdrop_MouseLeftButtonDown" />
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource ElevatedBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="24">
        <StackPanel>
          <TextBlock Text="Finaliser la fiche" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Indiquez la date de fin de préparation. La fiche passera dans l’historique."
                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
          <TextBlock Text="Date de fin de préparation" Style="{StaticResource FieldLabel}" />
          <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource DarkDatePicker}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" Command="{Binding CancelFinalizeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
            <Button Content="Confirmer la finalisation" Command="{Binding ConfirmFinalizeCommand}" Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
