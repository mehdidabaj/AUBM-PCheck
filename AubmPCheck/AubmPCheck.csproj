<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon></ApplicationIcon>
    <AssemblyName>AubmPCheck</AssemblyName>
    <RootNamespace>AubmPCheck</RootNamespace>
    <Product>AUBM PCheck</Product>
    <Version>1.0.0</Version>
    <Authors>AUBM</Authors>
    <Description>Fiches de préparation PC avec checklist, historique, export PDF et impression</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

</Project>
