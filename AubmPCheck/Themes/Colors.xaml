<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light professional workspace + deep slate sidebar -->
  <Color x:Key="BgColor">#FFEEF2F7</Color>
  <Color x:Key="ElevatedColor">#FFFFFFFF</Color>
  <Color x:Key="SoftColor">#FFF4F7FB</Color>
  <Color x:Key="LineColor">#FFD3DCE8</Color>
  <Color x:Key="TextColor">#FF142033</Color>
  <Color x:Key="MutedColor">#FF5B6B7C</Color>
  <Color x:Key="AccentColor">#FF0F766E</Color>
  <Color x:Key="AccentStrongColor">#FF0B5F59</Color>
  <Color x:Key="AccentSoftColor">#FFD9F3EF</Color>
  <Color x:Key="DangerColor">#FFC24141</Color>
  <Color x:Key="SidebarColor">#FF102033</Color>
  <Color x:Key="SidebarMutedColor">#FF9AABBD</Color>
  <Color x:Key="SidebarLineColor">#FF243447</Color>
  <Color x:Key="InputBgColor">#FFFFFFFF</Color>
  <Color x:Key="InputBorderColor">#FFC5D0DE</Color>
  <Color x:Key="FocusColor">#FF0F766E</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
  <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource SoftColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
  <SolidColorBrush x:Key="SidebarLineBrush" Color="{StaticResource SidebarLineColor}" />
  <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
