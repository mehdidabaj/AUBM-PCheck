<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#FF10151C</Color>
  <Color x:Key="ElevatedColor">#FF171E28</Color>
  <Color x:Key="SoftColor">#FF1D2633</Color>
  <Color x:Key="LineColor">#FF2A3545</Color>
  <Color x:Key="TextColor">#FFE8EEF6</Color>
  <Color x:Key="MutedColor">#FF93A0B3</Color>
  <Color x:Key="AccentColor">#FF2BB8A0</Color>
  <Color x:Key="AccentStrongColor">#FF1F9A85</Color>
  <Color x:Key="DangerColor">#FFE06B6B</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
  <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource SoftColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#242BB8A0" />
</ResourceDictionary>
